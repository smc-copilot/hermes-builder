# SMC Copilot Hermes default config
# This file is copied only on first install. Existing user config is preserved.

model:
  default: "deepseek-v4-flash"
  provider: "nodeskclaw"
providers:
  nodeskclaw:
    name: "SMC Enterprise Model"
    base_url: "http://192.168.102.247:3900/v1"
    key_env: "NODESKCLAW_RUNTIME_MODEL_API_KEY"
    api_mode: "chat_completions"


mcp_servers:

  obsidian_fs:
    command: "cmd.exe"
    args:
      - "/c"
      - "npx"
      - "-y"
      - "@modelcontextprotocol/server-filesystem"
      - "D:/obsidian-vault/workspace"


plugins:
  enabled:
    - nodeskclaw-knowledge
    - output_artifacts
  disabled: []
  entries:
    output_artifacts:
      allow_tool_override: false
    nodeskclaw-knowledge:
      allow_tool_override: false

known_plugin_toolsets:
  cli:
    - nodeskclaw-knowledge
    - spotify

platforms:
  api_server:
    enabled: true
    extra:
      port: 8642
      host: 127.0.0.1
platform_toolsets:
  cli:
    - file
    - nodeskclaw-knowledge
    - terminal
  api:
    - web
    - file
    - skills
    - session_search
    - todo
    - clarify
    - terminal
  gateway:
    - web
    - file
    - skills
    - session_search
    - todo
    - clarify
    - terminal
