<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="SMC Copilot Hermes"
      Manufacturer="SMC"
      Version="$(var.ProductVersion)"
      UpgradeCode="7F5E14D8-61A1-48D3-9EA5-503A84C61F6F"
      Language="2052"
      Scope="perUser"
      InstallerVersion="500"
      Compressed="yes">

    <SummaryInformation Description="SMC Copilot Hermes Enterprise Runtime" Manufacturer="SMC" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of SMC Copilot Hermes is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Fail early with a clear message before any payload is laid down. -->
    <Launch Condition="VersionNT64" Message="SMC Copilot Hermes requires 64-bit Windows." />
    <Launch Condition="VersionNT &gt;= 603" Message="SMC Copilot Hermes requires Windows 8 / Windows Server 2012 or newer." />
    <Launch Condition="NOT UserSID = &quot;S-1-5-18&quot;" Message="This is a per-user installer and must not be run as SYSTEM. Install from an interactive user session so files go to that user's %LOCALAPPDATA%\hermes." />

    <Feature Id="MainFeature" Title="SMC Copilot Hermes" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
    </Feature>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="HermesRoot" Name="hermes">
      </Directory>
    </StandardDirectory>

    <!-- WiX v4 native recursive harvesting. Payload is generated by build/Build.ps1. -->
    <ComponentGroup Id="PayloadComponents" Directory="HermesRoot">
      <Files Include="$(var.PayloadDir)\**" />
    </ComponentGroup>

    <!--
      Explicit Set*Property CAs write the command line into a property that
      matches the deferred WixQuietExec CA Id. Do not reuse the same Id for
      SetProperty and the QuietExec CustomAction (causes 0x80070057).
    -->
    <CustomAction
        Id="SetPreflightHermes"
        Property="PreflightHermes"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[HermesRoot]bootstrap\Preflight-HermesInstall.ps1&quot; -HermesHome &quot;[HermesRoot].&quot;"
        Execute="immediate"
        Impersonate="yes" />
    <CustomAction
        Id="PreflightHermes"
        BinaryRef="Wix4UtilCA_X64"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="yes"
        Return="check" />

    <CustomAction
        Id="SetInitializeHermes"
        Property="InitializeHermes"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[HermesRoot]bootstrap\Initialize-Hermes.ps1&quot; -HermesHome &quot;[HermesRoot].&quot;"
        Execute="immediate"
        Impersonate="yes" />
    <CustomAction
        Id="InitializeHermes"
        BinaryRef="Wix4UtilCA_X64"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="yes"
        Return="check" />

    <CustomAction
        Id="SetCleanupHermes"
        Property="CleanupHermes"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[HermesRoot]bootstrap\Cleanup-Hermes.ps1&quot; -HermesHome &quot;[HermesRoot].&quot;"
        Execute="immediate"
        Impersonate="yes" />
    <CustomAction
        Id="CleanupHermes"
        BinaryRef="Wix4UtilCA_X64"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SetPreflightHermes" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="PreflightHermes" After="SetPreflightHermes" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="SetInitializeHermes" After="PreflightHermes" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="InitializeHermes" After="SetInitializeHermes" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="SetCleanupHermes" Before="CleanupHermes" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CleanupHermes" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
