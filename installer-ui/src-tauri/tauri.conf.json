{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Setup",
  "version": "2.0.0",
  "identifier": "com.smc.copilot.hermes.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hermes Setup 2.0.0",
        "width": 760,
        "height": 560,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
